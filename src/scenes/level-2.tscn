script/source = "extends Node

@onready var scene_root = $\"../..\"

var lb_rendered = false

func _process(delta:float):
	print(\"crap\")
	if scene_root.speedrun_state != scene_root.NOT_SPEEDRUNNING:
		$SpeedrunSubmission.show()
		$SpeedrunNames.show()
		print(\"double crap\")
		if not lb_rendered:
			print(\"triple crap\")
			await render_lb()
	else:
		$SpeedrunSubmission.hide()
		$SpeedrunNames.hide()

func render_lb() -> void:
	var sw_result = await SilentWolf.Scores.get_scores().sw_get_scores_complete
	var scores = sw_result.scores
	print(scores)
	print(\"isnae\")
	lb_rendered = true

func scorify(score:int) -> int:
	return 1 << 63 - score
"

